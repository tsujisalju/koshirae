# Enoki zkLogin — Google sign-in as a wallet option in ConnectButton.
# Get these from https://portal.enoki.mystenlabs.com (API key) and the
# Google Cloud Console (OAuth 2.0 Web Client ID). Must be NEXT_PUBLIC_
# since lib/dapp-kit.ts only ever runs client-side.
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Mirrors executor/.env — the frontend needs these to build the same
# create_agent_cap PTB the executor already knows how to act against.
NEXT_PUBLIC_ORONYX_PACKAGE_ID=
NEXT_PUBLIC_ORONYX_OPERATOR_ADDR=
NEXT_PUBLIC_ORONYX_MOCK_POOL_ID=

# Executor's published port (see docker-compose.yml) — sponsored
# transactions are proxied through /sponsor and /execute-sponsored there,
# since Enoki's gas station requires a private key the frontend must never
# hold.
NEXT_PUBLIC_EXECUTOR_URL=

# agent-service's published port (see docker-compose.yml) — backs the
# agents list page's GET /agents?owner= call.
NEXT_PUBLIC_AGENT_SERVICE_URL=
